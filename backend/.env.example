# Database connection string.
# PostgreSQL in production, e.g. postgresql+psycopg://user:pass@localhost:5432/jvt
# SQLite is used for local/dev and tests, e.g. sqlite:///./jvt.db
DB_URL=sqlite:///./jvt.db

# Server-held OpenAI API key. The browser never sees this; the backend proxies
# all LLM calls on the authenticated Learner's behalf.
OPENAI_API_KEY=sk-your-key-here

# Secret used to sign JWT session tokens. Use a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret
