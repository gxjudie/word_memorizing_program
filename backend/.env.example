# Database connection string.
DB_URL=sqlite:///./jvt.db

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials,
# application type "Web application"). Register OAUTH_REDIRECT_URI below as an
# authorized redirect URI on that client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Long random secret for the application's own signed session.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret

# Fernet key for the sign-in start cookie and each Learner's stored Gemini key.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key

# Gemini model used for sentence generation. Each Learner connects their own
# Gemini API key in the app; there is no developer-held key setting.
GEMINI_MODEL=gemini-flash-lite-latest
